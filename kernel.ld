/* エントリーポイントはboot関数だと設定する。 */
ENTRY(boot)

SECTIONS { /* 各セクションの配置を定義 */
	/* ベースアドレスの設定 */
	/* '.' は 現在のアドレスを表す */
	. = 0x80200000;

	.text :{ /* コード領域 */
		/* .text.bootセクションを先頭にする。 */
		KEEP(*(.text.boot));
		*(.text .text.*);
	}

	.rodata : ALIGN(4) { /* 定数データ領域。読み取り専用。 */
		*(.rodata .rodata.*);
	}
	
	.data : ALIGN(4) { /* 読み書き可能データ領域 */
		*(.data .data.*);
	}

	.bss : ALIGN(4) { /* 読み書き可能データ領域。初期値がゼロの変数を配置する。 */
		/* __bss というシンボルに現在のアドレスを割り当てる */
		/* シンボル: 関数、静的変数を表すもの */
		__bss = .;
		*(.bss .bss.* .sbss .sbss.*);
		__bss_end = .;
	}

	/* ALIGN(4): 4バイト境界になるようにアドレスを調整する。 */
	/* . += 128 * 1024: 現在のアドレスから128KB進める。 */

	. = ALIGN(4);
	. += 128 * 1024; /* 128KB */
	/* __stack_topというシンボルに現在のアドレスを割り当てる */
	__stack_top = .;

}